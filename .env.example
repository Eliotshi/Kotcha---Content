# ── Supabase (projet kotcha-content) ──
NEXT_PUBLIC_SUPABASE_URL=https://jhetemxgcvpdydrmguhq.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_nRQ5sySXazHYO3FVQl_6Ng_ZrhYgAB-
# Clé secrète (Dashboard Supabase → Project Settings → API Keys → secret / service_role). Serveur uniquement.
SUPABASE_SECRET_KEY=

# ── URL publique de l'app (utilisée pour les webhooks Apify) ──
APP_URL=http://localhost:3000

# ── Secrets internes (générer avec : openssl rand -hex 32) ──
# Vercel envoie automatiquement "Authorization: Bearer $CRON_SECRET" aux crons.
CRON_SECRET=
# Protège le webhook Apify et l'endpoint de traitement interne.
JOBS_SECRET=

# ── Apify ──
APIFY_TOKEN=
# Actors utilisés (modifiables sans toucher au code)
APIFY_INSTAGRAM_ACTOR=apify/instagram-scraper
APIFY_TIKTOK_ACTOR=clockworks/tiktok-scraper
APIFY_LINKEDIN_ACTOR=harvestapi/linkedin-company-posts
# Nombre de posts récupérés par compte et par collecte (permet aussi de rafraîchir les métriques)
APIFY_POSTS_PER_ACCOUNT=12

# ── IA ──
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# Transcription audio (optionnelle — sans clé, seuls les sous-titres TikTok et le texte à l'écran sont utilisés)
OPENAI_API_KEY=
TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
